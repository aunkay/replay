{
  "name": "replay-market-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:iphone": "playwright test --project=iphone13-webkit",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:types": "tsc -p tsconfig.e2e.json",
    "format": "prettier --write src tests *.ts *.json index.html",
    "screenshots": "node scripts/screenshots.mjs",
    "build:engine": "esbuild engine/server.ts --bundle --platform=node --format=cjs --outfile=dist-engine/server.cjs",
    "engine": "npm run build:engine && node dist-engine/server.cjs",
    "research:strategies": "esbuild scripts/strategy-research.ts --bundle --platform=node --format=esm --outfile=/tmp/replay-strategy-research.mjs && node /tmp/replay-strategy-research.mjs"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
